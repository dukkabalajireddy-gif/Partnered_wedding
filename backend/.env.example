# Copy this file to ".env" and fill in your real values. Never commit ".env".
# Works with any OpenAI-compatible provider. Pick ONE base URL (check the provider docs):
#   Groq:      https://api.groq.com/openai/v1
#   xAI Grok:  https://api.x.ai/v1
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Exact model name from the provider's console/docs (must support tool calling)
LLM_MODEL=put-model-name-here
# Frontend address allowed to call this backend
FRONTEND_ORIGIN=http://localhost:8443
