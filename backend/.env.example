# Copy this file to ".env" and fill in your real values. Never commit ".env".
# Works with any OpenAI-compatible provider. Pick ONE base URL (check the provider docs):
#   Groq:      https://api.groq.com/openai/v1
#   xAI Grok:  https://api.x.ai/v1
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Exact model name from the provider's console/docs (must support tool calling)
LLM_MODEL=put-model-name-here
# Frontend address allowed to call this backend
FRONTEND_ORIGIN=http://localhost:8443

# Delhivery shipment tracking. Get a token from your Delhivery account; keep it only here and in Vercel's environment variables.
# Leave DELHIVERY_TOKEN empty to use demo waybills only (DEMO1 to DEMO5).
DELHIVERY_TOKEN=
# staging (default) or production
DELHIVERY_ENV=staging

# Pine Labs Online payments (Settings > API Keys in the Pine Labs dashboard, test mode). Keep these only here and in Vercel.
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
# uat (test, default) or production
PINELABS_ENV=uat
# Optional: the API address. Needed for production until Pine Labs confirms the live one.
# PINELABS_BASE_URL=

# Gnani voice (speak a message, listen to a reply): English and Hindi. Key from app.gnani.ai/voice. Keep it only here and in Vercel.
GNANI_API_KEY=
